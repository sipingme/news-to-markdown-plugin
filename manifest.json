{
  "manifest_version": 3,
  "name": "News to Markdown Plugin",
  "version": "1.0.0",
  "description": "Extract content from websites (especially Xiaohongshu) and convert to Markdown format",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://xhs.cn/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xhs.cn/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": [
        "lib/turndown.js",
        "content/extractors/base.js",
        "content/extractors/xiaohongshu.js",
        "content/extractors/zhihu.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
